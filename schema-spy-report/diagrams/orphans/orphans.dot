      <TR><TD PORT="locked_at" COLSPAN="2" ALIGN="LEFT"><TABLE BORDER="0" CELLSPACING="0" ALIGN="LEFT"><TR ALIGN="LEFT"><TD ALIGN="LEFT" FIXEDSIZE="TRUE" WIDTH="15" HEIGHT="16"></TD><TD ALIGN="LEFT" FIXEDSIZE="TRUE" WIDTH="66" HEIGHT="16">locked_at</TD></TR></TABLE></TD><TD PORT="locked_at.type" ALIGN="LEFT">timestamp[26,3]</TD></TR>
